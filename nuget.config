<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Discord.Net nightlies. Needed until a release includes the DAVE voice fix (discord-net/Discord.Net#3288). -->
    <add key="discord-net-nightly" value="https://baget.discordnet.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="discord-net-nightly">
      <package pattern="Discord.Net" />
      <package pattern="Discord.Net.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
