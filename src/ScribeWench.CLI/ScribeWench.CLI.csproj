<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>scribewench</AssemblyName>
    <OutputType>Exe</OutputType>
    <!-- The version the program reports. A release gets its number from its tag (see .github/workflows/release.yml). -->
    <Version>0.0.0-dev</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <!--
      Publish makes one exe with everything in it, the native DLLs too (Whisper, LLamaSharp, opus,
      libsodium, libdave). Whisper.net and LLamaSharp only look for theirs in folders next to the
      program, so the exe unpacks itself to %TEMP%\.net\scribewench the first time it starts and
      runs from there.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ScribeWench.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScribeWench.Core\ScribeWench.Core.csproj" />
    <ProjectReference Include="..\ScribeWench.Transcription\ScribeWench.Transcription.csproj" />
    <ProjectReference Include="..\ScribeWench.AI\ScribeWench.AI.csproj" />
    <ProjectReference Include="..\ScribeWench.Bot\ScribeWench.Bot.csproj" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Discord's voice encryption (DAVE). No package has it, so the DLL is checked in. -->
    <None Include="..\..\native\win-x64\libdave.dll" Link="libdave.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- The Whisper and LLamaSharp packages bring native libraries for every system. The exe is for
       64-bit Windows, so the rest stays out of it. -->
  <Target Name="PublishWindowsNativesOnly" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_NativeForAnotherSystem Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::new('%(RelativePath)').Replace('\', '/').StartsWith('runtimes/')) and !$([System.String]::new('%(RelativePath)').Replace('\', '/').Contains('/win-x64/'))" />
      <_NativeForAnotherSystem Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'ggml-metal.metal'" />
      <ResolvedFileToPublish Remove="@(_NativeForAnotherSystem)" />
    </ItemGroup>
  </Target>
</Project>
